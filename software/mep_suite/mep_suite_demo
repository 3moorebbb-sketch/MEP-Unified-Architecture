        "# 1. Create Sequential Tasks (Left vs Right side of a parabola)\n",
        "X_full = torch.linspace(-2, 2, 200).unsqueeze(1)\n",
        "Y_full = X_full ** 2\n",
        "\n",
        "X_taskA = torch.linspace(-2, 0, 100).unsqueeze(1) # Left side\n",
        "Y_taskA = X_taskA ** 2\n",
        "\n",
        "X_taskB = torch.linspace(0, 2, 100).unsqueeze(1)  # Right side\n",
        "Y_taskB = X_taskB ** 2\n",
        "\n",
        "# 2. Train Base Model on Task A\n",
        "print(\"Training Base Model on Task A (Left side)...\")\n",
        "base_model = MEPTopologicalNetwork(input_dim=1, hidden_dim=64, output_dim=1)\n",
        "opt_base = torch.optim.SGD(base_model.parameters(), lr=0.01)\n",
        "criterion = nn.MSELoss()\n",
        "\n",
        "for _ in range(500):\n",
        "    opt_base.zero_grad()\n",
        "    loss = criterion(base_model(X_taskA), Y_taskA)\n",
        "    loss.backward()\n",
        "    opt_base.step()\n",
        "\n",
        "# 3. Create competing models for Task B\n",
        "model_naive = MEPTopologicalNetwork(input_dim=1, hidden_dim=64, output_dim=1)\n",
        "model_naive.load_state_dict(base_model.state_dict())\n",
        "opt_naive = torch.optim.SGD(model_naive.parameters(), lr=0.01)\n",
        "\n",
        "model_mep = MEPTopologicalNetwork(input_dim=1, hidden_dim=64, output_dim=1)\n",
        "model_mep.load_state_dict(base_model.state_dict())\n",
        "opt_mep = torch.optim.SGD(model_mep.parameters(), lr=0.01)\n",
        "\n",
        "# 4. Train on Task B (Right side)\n",
        "print(\"Learning Task B (Right side) - Testing for Catastrophic Forgetting...\")\n",
        "# Grab random anchors from Task A for the JVP Engine\n",
        "x_anchors_A = X_taskA[torch.randperm(100)[:20]]\n",
        "\n",
        "for _ in range(500):\n",
        "    # Naive Model (Forgets)\n",
        "    opt_naive.zero_grad()\n",
        "    loss_naive = criterion(model_naive(X_taskB), Y_taskB)\n",
        "    loss_naive.backward()\n",
        "    opt_naive.step()\n",
        "\n",
        "    # MEP Jacobian Tether Model (Remembers)\n",
        "    opt_mep.zero_grad()\n",
        "    loss_B = criterion(model_mep(X_taskB), Y_taskB)\n",
        "    tether_penalty = compute_topological_tether(model_mep, base_model, x_anchors_A)\n",
        "    loss_mep_total = loss_B + (50.0 * tether_penalty) # Lambda = 50\n",
        "    loss_mep_total.backward()\n",
        "    opt_mep.step()\n",
        "\n",
        "# 5. Plot the Visual Proof\n",
        "plt.figure(figsize=(10, 5))\n",
        "plt.plot(X_full.numpy(), Y_full.numpy(), color='white', label='True Full Parabola', linewidth=2)\n",
        "plt.plot(X_full.numpy(), model_naive(X_full).detach().numpy(), color='red', linestyle='dashed', label='Naive SGD (Forgot Task A)')\n",
        "plt.plot(X_full.numpy(), model_mep(X_full).detach().numpy(), color='cyan', linestyle='dashed', label='MEP Jacobian Tether (Remembered Both)')\n",
        "plt.axvline(x=0, color='gray', linestyle='dotted', label='Task Boundary')\n",
        "plt.title(\"Catastrophic Forgetting vs MEP Jacobian Topological Tether\")\n",
        "plt.legend()\n",
        "plt.show()\n"
