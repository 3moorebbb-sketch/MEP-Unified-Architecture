        "# 1. Create a \"bumpy\" non-linear dataset\n",
        "X = torch.linspace(-3, 3, 200).unsqueeze(1)\n",
        "Y = X * torch.sin(4 * X) # The true landscape\n",
        "\n",
        "# 2. Define a simple Multi-Layer Perceptron\n",
        "class SimpleNet(nn.Module):\n",
        "    def __init__(self):\n",
        "        super().__init__()\n",
        "        self.net = nn.Sequential(nn.Linear(1, 32), nn.ReLU(), nn.Linear(32, 32), nn.ReLU(), nn.Linear(32, 1))\n",
        "    def forward(self, x):\n",
        "        return self.net(x)\n",
        "\n",
        "# 3. Create two identical networks starting from the EXACT same weights\n",
        "model_adam = SimpleNet()\n",
        "model_mep = SimpleNet()\n",
        "model_mep.load_state_dict(model_adam.state_dict())\n",
        "\n",
        "# 4. Initialize Optimizers\n",
        "opt_adam = torch.optim.Adam(model_adam.parameters(), lr=0.01)\n",
        "opt_mep = RiemannianOptimizer(model_mep.parameters(), lr=0.05, mass=0.9, base_temp=0.0) # V3.1 Config\n",
        "criterion = nn.MSELoss()\n",
        "\n",
        "# 5. Train both models (150 steps)\n",
        "print(\"Training Adam vs. MEP Riemannian Engine...\")\n",
        "for _ in range(150):\n",
        "    # Adam Step\n",
        "    opt_adam.zero_grad()\n",
        "    loss_adam = criterion(model_adam(X), Y)\n",
        "    loss_adam.backward()\n",
        "    opt_adam.step()\n",
        "\n",
        "    # MEP Step\n",
        "    opt_mep.zero_grad()\n",
        "    loss_mep = criterion(model_mep(X), Y)\n",
        "    loss_mep.backward()\n",
        "    opt_mep.step()\n",
        "\n",
        "# 6. Plot the Visual Proof\n",
        "plt.figure(figsize=(10, 5))\n",
        "plt.plot(X.numpy(), Y.numpy(), color='white', label='True Mathematical Landscape', linewidth=2)\n",
        "plt.plot(X.numpy(), model_adam(X).detach().numpy(), color='red', linestyle='dashed', label=f'Adam (Stuck) - Loss: {loss_adam.item():.2f}')\n",
        "plt.plot(X.numpy(), model_mep(X).detach().numpy(), color='cyan', linestyle='dashed', label=f'MEP Optimizer - Loss: {loss_mep.item():.2f}')\n",
        "plt.title(\"Riemannian Optimization vs Adam in a Non-Convex Landscape\")\n",
        "plt.legend()\n",
        "plt.show()"
