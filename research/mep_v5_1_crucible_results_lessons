    </main>

    <script>
        const canvas = document.getElementById('swarmCanvas');
        const ctx = canvas.getContext('2d', { alpha: false });

        let width, height;
        let nodes = [];
        let ripples = [];
        // High density swarm (divided by 3500)
        let NUM_NODES = 500; 

        let isDrawing = false;
        let mouseX = -1000;
        let mouseY = -1000;

        function resize() {
            width = window.innerWidth;
            height = window.innerHeight;
            canvas.width = width;
            canvas.height = height;
            
            // Adjust swarm density for larger screens
            NUM_NODES = Math.max(300, Math.min(Math.floor((width * height) / 3500), 800));
            
            while(nodes.length < NUM_NODES) nodes.push(new Node());
            if(nodes.length > NUM_NODES) nodes.length = NUM_NODES;
        }
        window.addEventListener('resize', resize);

        class Node {
            constructor() {
                this.x = Math.random() * (window.innerWidth || 1000);
                this.y = Math.random() * (window.innerHeight || 1000);
                this.vx = (Math.random() - 0.5) * 0.5;
                this.vy = (Math.random() - 0.5) * 0.5;
                
                this.heat = 0;           
                this.phase = Math.random() * Math.PI * 2; 
                this.basePhase = this.phase; 
                this.isResonant = false;
            }

            update() {
                this.x += this.vx;
                this.y += this.vy;
                
                if (this.x < 0) this.x = width;
                if (this.x > width) this.x = 0;
                if (this.y < 0) this.y = height;
                if (this.y > height) this.y = 0;

                let envTemp = Math.max(0.1, 1.0 - (this.x / width));
                this.heat += (envTemp * 0.01) - 0.015; 
                
                if (this.heat < 0) this.heat = 0;
                if (this.heat > 1.0) this.heat = 1.0;

                if (this.heat > 0.8 && Math.random() < 0.05) {
                    ripples.push(new Ripple(this.x, this.y, this.heat, this.phase));
                    this.heat -= 0.2; 
                }
                
                this.isResonant = this.heat > 0.5;
                let langevinNoise = (Math.random() - 0.5) * Math.sqrt(envTemp) * 0.1;
                
                if (!this.isResonant) {
                    let diff = this.basePhase - this.phase;
                    this.phase += (diff * 0.01) + langevinNoise;
                } else {
                    this.phase += langevinNoise;
                }
            }

            draw() {
                ctx.beginPath();
                ctx.arc(this.x, this.y, this.isResonant ? 2.5 : 1.5, 0, Math.PI * 2);
                
                if (this.isResonant) {
                    // Changed to a fiery red/orange palette for the failure report
                    let r = Math.floor(Math.sin(this.phase) * 50 + 200); 
                    let g = Math.floor(Math.sin(this.phase + 2) * 80 + 100); 
                    let b = Math.floor(Math.sin(this.phase + 4) * 40 + 20);
                    ctx.fillStyle = `rgb(${r}, ${g}, ${b})`;
                } else {
                    ctx.fillStyle = `rgba(239, 68, 68, ${0.1 + (this.heat * 0.2)})`;
                }
                ctx.fill();
            }
        }

        class Ripple {
            constructor(x, y, energy, phase) {
                this.x = x;
                this.y = y;
                this.energy = energy;
                this.phase = phase;
                this.radius = 0;
                this.maxRadius = energy * 150;
                this.opacity = 1.0;
                this.speed = 3 + Math.random() * 2;
            }

            update() {
                this.radius += this.speed;
                this.opacity = 1.0 - (this.radius / this.maxRadius);
                
                nodes.forEach(n => {
                    let dist = Math.hypot(n.x - this.x, n.y - this.y);
                    if (Math.abs(dist - this.radius) < this.speed) {
                        n.heat = Math.min(n.heat + this.energy * 0.5 * this.opacity, 1.0);
                        if (n.heat > 0.4) {
                            n.phase += Math.sin(this.phase - n.phase) * 0.2;
                        }
                    }
                });
            }

            draw() {
                if (this.opacity <= 0) return;
                ctx.beginPath();
                ctx.arc(this.x, this.y, this.radius, 0, Math.PI * 2);
                // Fiery ripple colors
                let r = Math.floor(Math.sin(this.phase) * 50 + 200); 
                let g = Math.floor(Math.sin(this.phase + 2) * 80 + 100); 
                let b = Math.floor(Math.sin(this.phase + 4) * 40 + 20);
                ctx.strokeStyle = `rgba(${r}, ${g}, ${b}, ${this.opacity * 0.5})`;
                ctx.lineWidth = 1.5;
                ctx.stroke();
            }
        }

        function initSwarm() {
            resize(); 
        }

        function animate() {
            // Dark background with a slight crimson undertone
            let grad = ctx.createLinearGradient(0, 0, width, 0);
            grad.addColorStop(0, 'rgba(15, 5, 5, 0.85)'); 
            grad.addColorStop(1, 'rgba(5, 2, 2, 0.85)'); 
            ctx.fillStyle = grad;
            ctx.fillRect(0, 0, width, height);

            if (isDrawing) {
                if (Math.random() < 0.3) {
                    let userPhase = (Date.now() * 0.001) % (Math.PI * 2);
                    ripples.push(new Ripple(mouseX, mouseY, 1.5, userPhase));
                }
                nodes.forEach(n => {
                    let d = Math.hypot(n.x - mouseX, n.y - mouseY);
                    if (d < 100) n.heat = 1.0;
                });
            }

            ctx.lineWidth = 0.5;
            for (let i = 0; i < nodes.length; i++) {
                let n1 = nodes[i];
                for (let j = i + 1; j < nodes.length; j++) {
                    let n2 = nodes[j];
                    let dist = Math.hypot(n1.x - n2.x, n1.y - n2.y);
                    
                    if (dist < 80 && n1.isResonant && n2.isResonant) {
                        let phaseDiff = Math.abs(n1.phase - n2.phase);
                        if (phaseDiff < 0.5 || Math.PI * 2 - phaseDiff < 0.5) {
                            ctx.beginPath();
                            ctx.moveTo(n1.x, n1.y);
                            ctx.lineTo(n2.x, n2.y);
                            
                            let r = Math.floor(Math.sin(n1.phase) * 50 + 200); 
                            let g = Math.floor(Math.sin(n1.phase + 2) * 80 + 100); 
                            let b = Math.floor(Math.sin(n1.phase + 4) * 40 + 20);
                            ctx.strokeStyle = `rgba(${r}, ${g}, ${b}, ${(1 - dist/80) * 0.8})`;
                            ctx.stroke();
                            
                            let couplingStrength = 0.05;
                            let phaseShift1 = Math.sin(n2.phase - n1.phase) * couplingStrength;
                            let phaseShift2 = Math.sin(n1.phase - n2.phase) * couplingStrength;
                            
                            n1.phase += phaseShift1;
                            n2.phase += phaseShift2;
                            
                            let avgHeat = (n1.heat + n2.heat) / 2;
                            let entropyTax = 0.005; 
                            n1.heat = Math.max(0, avgHeat - entropyTax);
                            n2.heat = Math.max(0, avgHeat - entropyTax);
                        }
                    }
                }
            }

            ripples.forEach((r, index) => {
                r.update();
                r.draw();
                if (r.opacity <= 0) ripples.splice(index, 1);
            });

            nodes.forEach(n => {
                n.update();
                n.draw();
            });

            requestAnimationFrame(animate);
        }

        function handleInput(e, isDown) {
            if (e.touches && e.touches.length > 0) {
                mouseX = e.touches[0].clientX;
                mouseY = e.touches[0].clientY;
            } else {
                mouseX = e.clientX;
                mouseY = e.clientY;
            }
            if (isDown !== undefined) isDrawing = isDown;
        }

        window.addEventListener('mousedown', (e) => handleInput(e, true));
        window.addEventListener('mousemove', (e) => handleInput(e));
        window.addEventListener('mouseup', () => isDrawing = false);

        window.addEventListener('touchstart', (e) => handleInput(e, true), {passive: true});
        window.addEventListener('touchmove', (e) => { handleInput(e); }, {passive: true});
        window.addEventListener('touchend', () => isDrawing = false);

        initSwarm();
        animate();
    </script>
